{
  "name": "knowledge-core",
  "version": "0.3.1",
  "private": true,
  "description": "Monorepo template for documentation and course platforms",
  "author": "casoon",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "24.11.0",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/**\" --parallel dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:courses": "pnpm --filter courses dev",
    "build": "pnpm build:docs && pnpm build:courses && pnpm build:worker",
    "build:docs": "pnpm --filter docs build",
    "build:courses": "pnpm --filter courses build",
    "build:worker": "pnpm --filter chat-worker build",
    "preview": "pnpm --filter \"./apps/**\" preview",
    "preview:docs": "pnpm --filter docs preview",
    "preview:courses": "pnpm --filter courses preview",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "pnpm --filter @knowledge-core/content-model test && pnpm --filter @knowledge-core/shared test && pnpm --filter chat-worker test",
    "test:watch": "pnpm -r --filter @knowledge-core/content-model --filter @knowledge-core/shared --filter chat-worker test:watch",
    "type-check": "pnpm --filter docs type-check && pnpm --filter courses type-check && pnpm --filter chat-worker type-check && pnpm type-check:scripts",
    "type-check:scripts": "tsc -p scripts/tsconfig.json",
    "linkcheck": "pnpm --filter docs linkcheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare": "husky",
    "ingest": "npx tsx scripts/ingest-content.ts"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,astro,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "sharp": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
}
