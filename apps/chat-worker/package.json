{
  "name": "chat-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "wrangler types --include-runtime false --check worker-configuration.d.ts && tsc --noEmit",
    "types": "wrangler types --include-runtime false worker-configuration.d.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.127.1"
  }
}
