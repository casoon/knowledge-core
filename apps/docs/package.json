{
  "name": "docs",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "type-check": "astro check",
    "clean": "rm -rf dist .astro",
    "linkcheck": "astro build && node --input-type=module -e \"import { CheckHtmlLinksCli } from 'check-html-links'; const checker = new CheckHtmlLinksCli({ argv: ['dist'] }); checker.setOptions({ continueOnError: false }); await checker.run();\""
  },
  "dependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/mdx": "catalog:",
    "@casoon/astro-post-audit": "catalog:",
    "@casoon/astro-site-files": "catalog:",
    "@casoon/astro-speed-measure": "catalog:",
    "@knowledge-core/content-model": "workspace:*",
    "@knowledge-core/shared": "workspace:*",
    "@knowledge-core/styles": "workspace:*",
    "@knowledge-core/ui": "workspace:*",
    "astro": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "check-html-links": "catalog:",
    "typescript": "catalog:"
  }
}
