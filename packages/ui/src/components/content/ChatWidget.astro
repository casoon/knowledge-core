---
export interface Props {
  apiEndpoint: string;
  placeholder?: string;
  title?: string;
}

const {
  apiEndpoint,
  placeholder = 'Ask AI about this project...',
  title = 'Knowledge AI Assistant',
} = Astro.props;
---

<div
  class="fixed bottom-6 right-6 z-50 font-sans"
  id="knowledge-chat-container"
  data-api-endpoint={apiEndpoint}
>
  <!-- Trigger Button -->
  <button
    id="chat-trigger"
    type="button"
    class="flex items-center justify-center w-14 h-14 rounded-full bg-primary hover:bg-primary-hover text-white shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 active:scale-95"
    aria-label="Open chat"
  >
    <svg class="w-6 h-6 chat-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
    </svg>
    <svg class="w-6 h-6 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Chat Panel -->
  <div
    id="chat-panel"
    class="hidden absolute bottom-18 right-0 w-[350px] sm:w-[400px] h-[500px] flex flex-col rounded-2xl border border-border bg-white/80 dark:bg-gray-900/80 backdrop-blur-lg shadow-2xl overflow-hidden transition-all duration-300 transform scale-95 origin-bottom-right"
  >
    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-primary/5">
      <div class="flex items-center gap-2">
        <div class="w-2.5 h-2.5 rounded-full bg-success animate-pulse"></div>
        <span class="text-sm font-semibold text-text">{title}</span>
      </div>
      <button
        id="chat-close"
        type="button"
        class="text-text-muted hover:text-text p-1 rounded-lg hover:bg-surface-alt transition-colors"
        aria-label="Close chat"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Messages Container -->
    <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4">
      <div class="flex gap-2 max-w-[85%]">
        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">AI</div>
        <div class="bg-surface-alt border border-border text-text text-sm rounded-2xl rounded-tl-none px-3 py-2 leading-relaxed">
          Hallo! Ich bin dein AI-Assistent. Frag mich gerne alles über die Dokumentation oder die Kurse in Knowledge Core.
        </div>
      </div>
    </div>

    <!-- Input Bar -->
    <form id="chat-form" class="p-3 border-t border-border bg-surface/50 flex gap-2">
      <input
        type="text"
        id="chat-input"
        aria-label="Ask AI assistant"
        placeholder={placeholder}
        autocomplete="off"
        class="flex-1 input bg-surface px-3 py-2 text-sm border-border rounded-xl focus:ring-1 focus:ring-primary focus:border-primary transition-all duration-200"
      />
      <button
        type="submit"
        class="btn btn-primary p-2 rounded-xl flex-shrink-0 active:scale-95 transition-transform"
        aria-label="Send message"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9-2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  // Bundled instead of is:inline/define:vars: the CSP only allows scripts Astro hashed or served from 'self'.
  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('knowledge-chat-container');
    const apiEndpoint = container?.dataset.apiEndpoint;
    if (!apiEndpoint) return;

    // Initialize state
    let isOpen = false;
    const chatHistory: { role: string; content: string }[] = [];

    const trigger = document.getElementById('chat-trigger');
    const panel = document.getElementById('chat-panel');
    const closeBtn = document.getElementById('chat-close');
    const messagesContainer = document.getElementById('chat-messages');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input') as HTMLInputElement | null;

    const chatIcon = trigger?.querySelector('.chat-icon');
    const closeIcon = trigger?.querySelector('.close-icon');

    function toggleChat() {
      isOpen = !isOpen;
      if (isOpen) {
        panel?.classList.remove('hidden');
        setTimeout(() => panel?.classList.remove('scale-95', 'opacity-0'), 50);
        chatIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        input?.focus();
      } else {
        panel?.classList.add('scale-95', 'opacity-0');
        setTimeout(() => panel?.classList.add('hidden'), 300);
        chatIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    }

    trigger?.addEventListener('click', toggleChat);
    closeBtn?.addEventListener('click', toggleChat);

    // Helper to escape HTML and parse simple markdown bold & code blocks
    function formatMessage(text: string) {
      const escaped = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    
      // Parse inline code `code`
      let formatted = escaped.replace(/`([^`]+)`/g, '<code class="bg-surface text-primary px-1.5 py-0.5 rounded font-mono text-xs border border-border">$1</code>');
    
      // Parse bold **text**
      formatted = formatted.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

      // Parse code blocks ```lang ... ```
      formatted = formatted.replace(/```(?:[a-zA-Z]+)?\n([\s\S]*?)```/g, '<pre class="bg-gray-950 dark:bg-black text-gray-100 p-3 rounded-lg font-mono text-xs overflow-x-auto border border-border my-2"><code class="block whitespace-pre">$1</code></pre>');

      // Parse paragraph breaks
      return formatted.replace(/\n/g, '<br>');
    }

    function appendMessage(sender: 'user' | 'assistant', text: string) {
      const messageDiv = document.createElement('div');
      messageDiv.className = 'flex gap-2 max-w-[85%]';
      if (sender === 'user') {
        messageDiv.className += ' ml-auto flex-row-reverse';
      }

      const avatarDiv = document.createElement('div');
      avatarDiv.className = 'flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm';
      if (sender === 'user') {
        avatarDiv.className += ' bg-primary text-white';
        avatarDiv.textContent = 'U';
      } else {
        avatarDiv.className += ' bg-primary/10 text-primary';
        avatarDiv.textContent = 'AI';
      }

      const contentDiv = document.createElement('div');
      contentDiv.className = 'text-text text-sm rounded-2xl px-3 py-2 leading-relaxed border border-border';
      if (sender === 'user') {
        contentDiv.className += ' bg-primary/5 rounded-tr-none';
      } else {
        contentDiv.className += ' bg-surface-alt rounded-tl-none';
      }
    
      contentDiv.innerHTML = formatMessage(text);
      messageDiv.appendChild(avatarDiv);
      messageDiv.appendChild(contentDiv);
      messagesContainer?.appendChild(messageDiv);
    
      // Scroll to bottom
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }

      return contentDiv;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!input) return;
      const text = input.value.trim();
      if (!text) return;

      input.value = '';
      appendMessage('user', text);

      // Add loading indicator bubble
      const responseBubble = appendMessage('assistant', '...');

      try {
        const response = await fetch(apiEndpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            message: text,
            history: chatHistory,
          }),
        });

        if (!response.ok) {
          throw new Error('Failed to get answer from AI Server.');
        }

        const reader = response.body?.getReader();
        const decoder = new TextDecoder();
        let aiResponseText = '';
        responseBubble.innerHTML = '';

        if (reader) {
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            const chunk = decoder.decode(value, { stream: true });
          
            // Split SSE lines
            const lines = chunk.split('\n');
            for (const line of lines) {
              if (line.startsWith('data: ')) {
                const dataText = line.slice(6).trim();
                if (dataText === '[DONE]') continue;
                try {
                  const parsed = JSON.parse(dataText);
                  if (parsed.response) {
                    aiResponseText += parsed.response;
                    responseBubble.innerHTML = formatMessage(aiResponseText);
                    if (messagesContainer) {
                      messagesContainer.scrollTop = messagesContainer.scrollHeight;
                    }
                  }
                } catch (e) {
                  // Not a valid JSON chunk, standard LLM text streams sometimes return raw tokens
                  aiResponseText += dataText;
                  responseBubble.innerHTML = formatMessage(aiResponseText);
                }
              }
            }
          }

          // Save to local history
          chatHistory.push({ role: 'user', content: text });
          chatHistory.push({ role: 'assistant', content: aiResponseText });
        }
      } catch (err) {
        responseBubble.innerHTML = `<span class="text-error font-medium">Error: ${(err as Error).message}</span>`;
      }
    });
  });
</script>
