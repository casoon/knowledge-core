# Site Configuration
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=Astro v6 Starter
PUBLIC_AUTHOR=Your Name
PUBLIC_LOCALE=en

# Feature Flags
PUBLIC_ENABLE_DARK_MODE=true

# Cloudflare (required for ingest-content.ts and chat-worker)
# Account ID: Cloudflare Dashboard → Right sidebar
CLOUDFLARE_ACCOUNT_ID=your-account-id
# API Token: dash.cloudflare.com/profile/api-tokens
# Permissions needed: Workers AI (Edit) + Vectorize (Edit)
CLOUDFLARE_API_TOKEN=your-api-token
# Vectorize index name (must match wrangler.toml)
CLOUDFLARE_VECTORIZE_INDEX=knowledge-core
# URL of the deployed chat worker (used by ChatWidget in production builds)
PUBLIC_CHAT_ENDPOINT=https://knowledge-core-chat-worker.<your-subdomain>.workers.dev/chat
