---
import { readFile } from 'node:fs/promises';
import config from 'virtual:casoon-pages/config';
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
import Diagram from '../components/Diagram.astro';

// Screenshots of the template's own live sites (kc-docs.casoon.dev, kc-courses.casoon.dev),
// captured with Playwright at 1280 × 800 and stored as WebP in site/public/screens/.
const run = `pnpm install
pnpm dev   # docs :4321, courses :4322, chat :8787`;

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;
---

<Base>
  <Hero
    title="Docs and courses from one monorepo."
    lead="Knowledge Core is a starting point for teams who publish documentation, training or a knowledge base: a docs site and a course platform with quizzes and progress, built from the same components and written in MDX. Optionally, an AI assistant answers visitor questions from your own content."
  >
    <Install
      commands={[
        {
          label: 'git',
          command: 'git clone https://github.com/casoon/knowledge-core.git',
        },
      ]}
    />
    <Badges>
      <Badge>Free · MIT</Badge>
      <Badge>v0.3.1</Badge>
      <Badge>Astro 7</Badge>
      <Badge>English · German</Badge>
    </Badges>
    <p class="actions">
      <Button href={url('docs/')}>Read the docs</Button>
      <Button href="https://kc-docs.casoon.dev/" variant="secondary">Live docs demo</Button>
      <Button href="https://kc-courses.casoon.dev/" variant="secondary">Live course demo</Button>
    </p>
    <img
      slot="output"
      class="shot"
      src={url('screens/docs-page.webp')}
      width="1280"
      height="800"
      alt="The live docs demo at kc-docs.casoon.dev: the Installation page with a sidebar for Getting started, Guides and Components on the left, a tip box in the text, an 'On this page' outline on the right and search, quiz, language and dark-mode controls in the header."
    />
  </Hero>

  <Features
    heading="Who it is for"
    items={[
      {
        title: 'Teams that document a product',
        body: 'Guides, references and how-tos in MDX, with a sidebar you configure, search, an outline per page and English and German versions.',
      },
      {
        title: 'Teams that train people',
        body: 'Courses split into modules and lessons, with quizzes, exercises and hints. Progress stays in the learner’s browser, so there is no account and no backend to run.',
      },
      {
        title: 'Both from one place',
        body: 'The docs site and the course site share their components and design tokens. Change a button or a colour once and both sites follow.',
      },
      {
        title: 'Mistakes caught before they go live',
        body: 'Every page and lesson is checked against a schema when the site builds. A missing title or an unknown course level stops the build instead of shipping a broken page.',
      },
    ]}
  />

  <section class="screens" aria-labelledby="screens-heading">
    <h2 id="screens-heading">The course platform</h2>
    <p class="intro">
      Both screenshots are from the live demo at{' '}
      <a href="https://kc-courses.casoon.dev/">kc-courses.casoon.dev</a>, built from the sample course
      that ships with the template.
    </p>
    <div class="grid">
      <figure>
        <img
          src={url('screens/courses-course.webp')}
          width="1280"
          height="800"
          loading="lazy"
          alt="Course page 'Getting Started with Knowledge Core': level badge beginner, duration, tags, a progress bar at 0 of 5 lessons, a Start Course button and the course content grouped into the modules AI Features, Introduction and Practice."
        />
        <figcaption>A course with its modules, lessons and the learner’s progress.</figcaption>
      </figure>
      <figure>
        <img
          src={url('screens/courses-quiz.webp')}
          width="1280"
          height="800"
          loading="lazy"
          alt="Quiz in a lesson after checking the answers: question 3 marked Correct with an explanation, question 4 marked Incorrect with the right answer 'In the packages/ui package' and a short explanation, and the result '3 of 4 correct (75%)' next to a Try Again button."
        />
        <figcaption>A quiz after checking: feedback and explanation per question.</figcaption>
      </figure>
    </div>
  </section>

  <Facts
    items={[
      { value: '2', label: 'sites: documentation and courses' },
      { value: '25', label: 'shared Astro components for both' },
      { value: '2', label: 'languages out of the box, English and German' },
      { value: '67', label: 'tests for schemas, i18n and the chat worker' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        You write pages and lessons as MDX files. When the sites build, each file is checked
        against the content schemas, and both apps take their look from the shared packages. The
        result is plain static files that run on any static host.
      </p>
      <p>
        The AI assistant is optional. One command indexes the same content in Cloudflare Vectorize,
        and a small Cloudflare Worker answers questions from it in a chat window on both sites.
      </p>
    </div>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 560, height: 760 }} />
    <div class="links">
      <Button href={url('docs/getting-started/project-structure/')} variant="secondary">
        Project structure
      </Button>
      <Button href={url('docs/guides/ai-chat/')} variant="secondary">AI assistant</Button>
    </div>
  </section>

  <Quickstart
    lead="Create a repository from the GitHub template or clone it, install once at the root, and one command starts everything."
    steps={[
      'Install Node.js 22.12 or newer and pnpm 9 or newer.',
      'Use the template on GitHub, or clone the repository with the line above.',
      'Run <code>pnpm install</code> and <code>pnpm dev</code>, then replace the sample pages and the sample course with your own.',
    ]}
  >
    <CodeBlock code={run} lang="sh" label="Start" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Is the AI chat assistant required?',
        a: 'No. It is optional and off by default. Activating it takes four steps: create a Cloudflare Vectorize index, configure the API credentials, ingest your content, and deploy the chat worker.',
      },
      {
        q: 'What happens if I skip the AI setup?',
        a: 'The docs and course sites build and run normally. The ChatWidget only renders once PUBLIC_CHAT_ENDPOINT is configured in the build environment, so nothing breaks or shows a broken widget without it.',
      },
      {
        q: 'Are my pages and lessons validated before they go live?',
        a: 'Yes. Every MDX file is checked against Zod content schemas when the site builds — a missing title or an invalid course level stops the build instead of shipping a broken page.',
      },
      {
        q: 'Can I use this without the course platform, just for documentation?',
        a: 'Yes. Docs and courses are separate apps in the monorepo (pnpm dev:docs, pnpm build:docs) that happen to share components and design tokens — you can run or deploy either one on its own.',
      },
      {
        q: 'Where do I change colors, fonts, or other design tokens?',
        a: 'In packages/styles/src/tokens.css for token values and packages/styles/src/global.css for the Tailwind v4 theme — both apps pick up the change since they share the same styles package.',
      },
    ]}
  />
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line, rgb(127 127 127 / 0.25));
    border-radius: 10px;
  }
  .screens,
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .intro {
    margin: 0 0 24px;
    font-size: 15.5px;
  }
  .intro a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 32px;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 10px;
    font-size: 14px;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
